#!/usr/bin/env bash

BIN_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
if [ -z "$ATLANTIC_DIR" ]; then
    export ATLANTIC_DIR="$(dirname "$BIN_DIR")/src"
fi

source "$ATLANTIC_DIR/scripts/caching.sh"
source "$ATLANTIC_DIR/scripts/config.sh"
source "$ATLANTIC_DIR/scripts/i18n.sh"

if [ -z "$MAIN_QML" ]; then
    export MAIN_QML="$(find "$ATLANTIC_DIR/quickshell" -type f \( -name "Shell.qml" -o -name "Bar.qml" \) 2>/dev/null | head -n 1)"
fi

is_alive() {
    local pid="$1"
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    if [ -d /proc ]; then
        if [ ! -f "/proc/$pid/status" ]; then
            return 1
        fi
        if grep -q '^State:[[:space:]]*Z' "/proc/$pid/status" 2>/dev/null; then
            return 1
        fi
        return 0
    fi
    return 0
}

terminate_and_wait() {
    local pid="$1"
    local timeout="${2:-2}"
    local count=0
    local max_count=$(( timeout * 10 ))

    if [ -z "$pid" ] || ! is_alive "$pid"; then
        return 0
    fi

    kill -TERM "$pid" 2>/dev/null

    while is_alive "$pid"; do
        sleep 0.1
        ((count++))
        if [ "$count" -ge "$max_count" ]; then
            kill -KILL "$pid" 2>/dev/null
            break
        fi
    done

    while is_alive "$pid" && [ "$count" -lt $(( max_count + 5 )) ]; do
        sleep 0.1
        ((count++))
    done
}

get_installed_version() {
    local version_file="${XDG_STATE_HOME:-$HOME/.local/state}/atlantic/version"
    local ver=""
    if [ -f "$version_file" ]; then
        ver=$(awk -F= '/^ATLANTIC_VERSION=/{gsub(/["'\'' ]/, "", $2); print $2}' "$version_file")
    fi
    if [ -z "$ver" ] && [ -n "$ATLANTIC_VERSION" ]; then
        ver="$ATLANTIC_VERSION"
    fi
    if [ -z "$ver" ]; then
        if [ -n "$ATLANTIC_DIR" ] && [ -f "$ATLANTIC_DIR/version.txt" ]; then
            ver=$(cat "$ATLANTIC_DIR/version.txt" 2>/dev/null | xargs)
        elif [ -f "$(dirname "$BIN_DIR")/version.txt" ]; then
            ver=$(cat "$(dirname "$BIN_DIR")/version.txt" 2>/dev/null | xargs)
        elif [ -n "$ATLANTIC_DIR" ] && [ -f "$(dirname "$ATLANTIC_DIR")/version.txt" ]; then
            ver=$(cat "$(dirname "$ATLANTIC_DIR")/version.txt" 2>/dev/null | xargs)
        fi
    fi
    if [ -z "$ver" ]; then
        ver="2.0.0"
    fi
    echo "$ver"
}

current_lang_setting="$(get_setting "general" '{}' | jq -r '.language // empty')"
if [ -z "$current_lang_setting" ]; then
    env_lang="${LANGUAGE:-${LANG:-en}}"
    env_lang_short="${env_lang:0:2}"
    current_general="$(get_setting "general" '{}')"
    new_general="$(printf '%s' "$current_general" | jq -c --arg lang "$env_lang_short" '. + {language: $lang}')"
    set_setting "general" "$new_general"
fi

show_help() {
    echo "$(t "cli.usage")"
    echo ""
    echo "$(t "cli.description")"
    echo ""
    echo "$(t "cli.commands")"
    echo "  launch <target> [args...]   $(t "cli.launch_desc")"
    echo "  msg <action|workspace> ...  $(t "cli.msg_desc")"
    echo "  ipc ...                      $(t "cli.ipc_desc")"
    echo "  kill                         $(t "cli.kill_desc")"
    echo ""
    echo "$(t "cli.script_commands")"
    echo "  exit                         $(t "cli.scripts.exit")"
    echo "  lock                         $(t "cli.scripts.lock")"
    echo "  volume                       $(t "cli.scripts.volume")"
    echo "  reload                       $(t "cli.scripts.reload")"
    echo "  weather                      $(t "cli.scripts.weather")"
    echo "  location                     $(t "cli.scripts.location")"
    echo "  screenshot                   $(t "cli.scripts.screenshot")"
    echo "  brightness                   $(t "cli.scripts.brightness")"
    echo "  current_focus                $(t "cli.scripts.current_focus")"
    echo "  monitors_detect              $(t "cli.scripts.monitors_detect")"
    echo "  location_manual              $(t "cli.scripts.location_manual")"
    echo "  blue_light_filter            $(t "cli.scripts.blue_light_filter")"
    echo ""
    echo "$(t "cli.options")"
    echo "  -v, --verbose                $(t "cli.verbose_desc")"
    echo "  -V, --version                $(t "cli.version_desc")"
    echo "  -h, --help                   $(t "cli.help_desc")"
    echo ""
    echo "$(t "cli.examples")"
    echo "  atlantic launch start"
    echo "  atlantic launch widgetredactor"
    echo "  atlantic msg workspace 1"
    echo "  atlantic msg workspace 2 move"
    echo "  atlantic msg open network wifi"
    echo "  atlantic msg toggle launcher"
    echo "  atlantic msg toggle clipboard"
    echo "  atlantic weather --current-temp"
    echo "  atlantic kill"
    echo ""
}

show_launch_help() {
    echo "$(t "cli.launch_help.usage")"
    echo ""
    echo "$(t "cli.launch_help.description")"
    echo ""
    echo "$(t "cli.launch_help.available_targets")"
    echo "  start            $(t "cli.launch_help.target_start")"
    echo "  widgetredactor  $(t "cli.launch_help.target_widgetredactor")"
    echo ""
    echo "$(t "cli.options")"
    echo "  -h, --help      $(t "cli.help_desc")"
    echo ""
}

show_msg_help() {
    echo "$(t "cli.msg_help.usage")"
    echo ""
    echo "$(t "cli.msg_help.description")"
    echo ""
    echo "$(t "cli.msg_help.available_commands")"
    echo "  workspace <num> [move]   $(t "cli.msg_help.cmd_workspace")"
    echo "  open <target> [sub]      $(t "cli.msg_help.cmd_open")"
    echo "  toggle <target> [sub]    $(t "cli.msg_help.cmd_toggle")"
    echo "  close                    $(t "cli.msg_help.cmd_close")"
    echo ""
    echo "$(t "cli.options")"
    echo "  -h, --help               $(t "cli.help_desc")"
    echo ""
}

show_ipc_help() {
    echo "$(t "cli.ipc_help.usage")"
    echo ""
    echo "$(t "cli.ipc_help.description")"
    echo ""
    echo "$(t "cli.options")"
    echo "  -h, --help               $(t "cli.help_desc")"
    echo ""
}

ensure_daemon() {
    local pid=""
    if [ -f "/tmp/atlanticd.pid" ]; then
        pid="$(cat "/tmp/atlanticd.pid" 2>/dev/null)"
    fi

    if [ -z "$pid" ] || ! is_alive "$pid"; then
        rm -f "/tmp/atlanticd.pid" 2>/dev/null
        rm -f "/tmp/atlanticd.lock" 2>/dev/null

        [ "$VERBOSE" = true ] && echo "$(t "cli.starting_daemon")"
        "$BIN_DIR/atlanticd" start > /dev/null 2>&1 &

        local count=0
        while [ "$count" -lt 15 ]; do
            if [ -f "/tmp/atlanticd.pid" ] && is_alive "$(cat "/tmp/atlanticd.pid" 2>/dev/null)"; then
                break
            fi
            sleep 0.1
            ((count++))
        done
    fi
}

VERBOSE=false

while [[ "$1" == -* ]]; do
    case "$1" in
        -v|--verbose)
            VERBOSE=true
            export ATLANTIC_VERBOSE=true
            shift
            ;;
        -V|--version)
            echo "atlantic v$(get_installed_version)"
            exit 0
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        *)
            break
            ;;
    esac
done

if [ $# -eq 0 ]; then
    show_help
    exit 0
fi

if [[ "$1" == "start" || "$1" == "stop" || "$1" == "status" ]]; then
    exec "$BIN_DIR/atlanticd" "$@"
fi

if [[ "$1" == "kill" ]]; then
    pid=""
    if [ -f "/tmp/atlanticd.pid" ]; then
        pid="$(cat "/tmp/atlanticd.pid" 2>/dev/null)"
    fi

    pkill -TERM -f "focus_daemon.py" 2>/dev/null
    if [ -n "$MAIN_QML" ]; then
        pkill -TERM -f "quickshell.*$MAIN_QML" 2>/dev/null
    fi

    if [ -n "$pid" ] && is_alive "$pid"; then
        terminate_and_wait "$pid" 2
    else
        pkill -TERM -f "atlanticd" 2>/dev/null
        sleep 0.2
        pkill -KILL -f "atlanticd" 2>/dev/null
    fi

    pkill -KILL -f "focus_daemon.py" 2>/dev/null
    if [ -n "$MAIN_QML" ]; then
        pkill -KILL -f "quickshell.*$MAIN_QML" 2>/dev/null
    fi

    rm -f "/tmp/atlanticd.pid" 2>/dev/null
    rm -f "/tmp/atlanticd.lock" 2>/dev/null
    echo "$(t "cli.daemon_stopped")"
    exit 0
fi

if [[ "$1" == "launch" ]]; then
    if [[ "$2" == "-h" || "$2" == "--help" ]]; then
        show_launch_help
        exit 0
    fi
    if [ -z "$2" ]; then
        echo "$(t "cli.error_missing_qml")"
        echo "$(t "cli.launch_usage")"
        exit 1
    fi

    TARGET="$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')"
    case "$TARGET" in
        start)
            QML_NAME="Start"
            ;;
        widgetredactor)
            QML_NAME="WidgetRedactor"
            ;;
        *)
            echo "$(t "cli.error_unknown_target" TARGET="$2")"
            show_launch_help
            exit 1
            ;;
    esac

    shift 2
    export ATLANTIC_LAUNCH_ARGS="$*"

    QML_FILE=$(find "$ATLANTIC_DIR/quickshell" -type f -name "${QML_NAME}.qml" 2>/dev/null | head -n 1)

    if [ -n "$QML_FILE" ]; then
        ensure_daemon
        export ATLANTIC_TARGET_FILE="$QML_FILE"
        exec quickshell -p "$ATLANTIC_DIR/quickshell/Runner.qml"
    else
        echo "$(t "cli.error_qml_not_found" NAME="${QML_NAME}" DIR="$ATLANTIC_DIR/quickshell/")"
        exit 1
    fi
fi

if [[ "$1" == "msg" ]]; then
    if [[ "$2" == "-h" || "$2" == "--help" || -z "$2" ]]; then
        show_msg_help
        exit 0
    fi
    ensure_daemon
    shift
    if [[ "$1" == "workspace" ]]; then
        shift
    fi
    exec "$ATLANTIC_DIR/scripts/qs_manager.sh" "$@"
fi

if [[ "$1" == "ipc" ]]; then
    if [[ "$2" == "-h" || "$2" == "--help" ]]; then
        show_ipc_help
        exit 0
    fi

    ensure_daemon

    SHELL_QML=$(find "$ATLANTIC_DIR/quickshell" -type f -name "Shell.qml" 2>/dev/null | head -n 1)

    if [ -z "$SHELL_QML" ] && [ -n "$MAIN_QML" ]; then
        SHELL_QML="$MAIN_QML"
    fi

    if [ -z "$SHELL_QML" ]; then
        echo "$(t "cli.error_shell_qml_not_found" DIR="$ATLANTIC_DIR/quickshell/")"
        exit 1
    fi

    shift
    exec quickshell -p "$SHELL_QML" ipc "$@"
fi

ALLOWED_SCRIPTS=(
    "exit"
    "lock"
    "volume"
    "reload"
    "weather"
    "location"
    "screenshot"
    "brightness"
    "current_focus"
    "monitors_detect"
    "location_manual"
    "blue_light_filter"
    "setup_hardware"
    "dashboard"
)

COMMAND="$1"
IS_ALLOWED=false
for s in "${ALLOWED_SCRIPTS[@]}"; do
    if [[ "$COMMAND" == "$s" ]]; then
        IS_ALLOWED=true
        break
    fi
done

SCRIPT_PATH="$ATLANTIC_DIR/scripts/${COMMAND}.sh"

if [ "$IS_ALLOWED" = true ] && [ -f "$SCRIPT_PATH" ]; then
    shift
    if [ "$VERBOSE" = true ]; then
        exec "$SCRIPT_PATH" --verbose "$@"
    else
        exec "$SCRIPT_PATH" "$@"
    fi
else
    echo "$(t "cli.error_unknown_command" CMD="$COMMAND")"
    show_help
    exit 1
fi
