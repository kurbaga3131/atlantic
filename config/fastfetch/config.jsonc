{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/zerene.txt",
    "color": {
      "1": "#00aaff",
      "2": "#0055ff"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "separator": "#00aaff"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{1}",
      "color": {
        "user": "#00d4ff"
      }
    },
    "break",
    {
      "type": "os",
      "key": "󱄅 os ",
      "keyColor": "#00aaff"
    },
    {
      "type": "cpu",
      "key": " cpu",
      "keyColor": "#0088ff"
    },
    {
      "type": "memory",
      "key": "󰘚 ram",
      "keyColor": "#00d4ff"
    },
    {
      "type": "shell",
      "key": " sh ",
      "keyColor": "#55aaff"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
